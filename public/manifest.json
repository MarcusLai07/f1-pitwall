{
  "manifest_version": 3,
  "name": "Pit Wall",
  "version": "0.1.0",
  "description": "One rearrangeable window for live F1 timing, fed by MultiViewer's local API.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["sidePanel", "storage", "contextMenus"],
  "host_permissions": ["http://localhost:10101/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": {
    "default_title": "Open Pit Wall",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  }
}
