{
  "manifest_version": 3,
  "name": "Pit Wall",
  "version": "0.2.0",
  "description": "One rearrangeable window for F1 timing, map and telemetry: live via MultiViewer, past sessions with your F1 TV sign-in.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "contextMenus",
    "cookies"
  ],
  "host_permissions": [
    "http://localhost:10101/*",
    "https://*.formula1.com/*",
    "https://api.openf1.org/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Pit Wall",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
